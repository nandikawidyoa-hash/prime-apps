# ==============================================================================
# PRIME APPS — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Security
SECRET_KEY=primeapps-super-secret-key-change-in-production-2026-xyz
SESSION_COOKIE_NAME=prime_session
ADMIN_SESSION_COOKIE_NAME=prime_admin_session

# Server Host & Port
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Local SQLite path (Default: /tmp/webstore.db or webstore.db)
DATABASE_FILE=/tmp/webstore.db

# Storage Service Configuration
# Choices: 'local' (static/uploads) or 's3' (AWS / Cloudflare R2)
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=primeapps-storage
S3_ENDPOINT_URL=

# Indonesian Payment Gateway (Midtrans / Xendit)
# Set PAYMENT_ENVIRONMENT to 'sandbox' or 'production'
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_SECRET=pg_secret_midtrans_simulation_prime_2026
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Gxxxxxxxx

# Xendit Alternative Gateway (Optional)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxx
XENDIT_CALLBACK_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Brand & Store Defaults
DEFAULT_STORE_NAME=PRIME APPS
DEFAULT_STORE_TAGLINE="Toko Digital Premium & Lisensi Aplikasi Resmi"
DEFAULT_CURRENCY=IDR
